---
import { Image } from "astro:assets";
import bronze from "../images/bronze.jpg";
import izzy from "../images/izzy.jpg";
import glasses from "../images/glasses.jpg";
import layers from "../images/layers.jpg";

/*
  Alt text doubles as image-search keywords, so each description names the
  service and the city rather than just describing a person.

  Alma should still confirm the service names below -- they are read from the
  photos, so "bronze" vs "copper" and "layers" vs "butterfly cut" are my best
  reading of the work, not her formulation.

  The photos themselves are deliberately NOT pixelated: the colour work is the
  product, so it stays sharp inside a pixel frame.
*/
const photos = [
  {
    src: bronze,
    alt: "Bronze copper hair color with face-framing blowout by Alma Juarez at The Mane Allure, Houston",
    tag: "BRONZE COPPER",
  },
  {
    src: izzy,
    alt: "Deep auburn red hair color on long layers by Alma Juarez at The Mane Allure, Houston",
    tag: "AUBURN RED",
  },
  {
    src: glasses,
    alt: "Jet black hair color with curtain bangs and long layers by Alma Juarez at The Mane Allure, Houston",
    tag: "JET BLACK",
  },
  {
    src: layers,
    alt: "Long layered cut on blue-black hair by Alma Juarez at The Mane Allure, Houston",
    tag: "LONG LAYERS",
  },
];
---

<section id="gallery" class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-8">
      <p class="pixel-kicker">LEVEL 04</p>
      <h2 class="pixel-title mt-3 text-2xl sm:text-4xl">TROPHY CASE</h2>
      <p class="mt-3 font-crt text-2xl text-lavender">
        Recent work &middot; {photos.length} unlocked
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        photos.map((photo) => (
          <figure class="crt-frame">
            <Image
              src={photo.src}
              alt={photo.alt}
              class="aspect-[2/3] w-full object-cover object-top sm:aspect-auto sm:h-96"
              loading="lazy"
            />
            <figcaption class="border-t-4 border-black bg-neon-pink px-3 py-2 font-pixel text-[9px] text-white">
              {photo.tag}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
