---
const { links = [] } = Astro.props;

// Alma's real years in the industry, used as the XP level in the HUD.
const level = Math.abs(new Date().getFullYear() - 2011);
---

<header class="hud fixed top-0 z-50 w-full">
  <!-- Status strip, styled after an arcade HUD. -->
  <div
    class="flex items-center justify-between px-3 py-2 text-[9px] sm:px-6"
  >
    <span class="text-neon-green">XP: COLORIST LVL {level}</span>

    <div class="flex items-center gap-2">
      <span class="sprite-heart" aria-hidden="true"></span>
      <div class="hud-bar" role="presentation">
        <div class="hud-bar__fill" style="width: 88%"></div>
      </div>
      <span class="hidden text-white sm:inline">HOUSTON, TX</span>
    </div>
  </div>

  <!-- Wordmark -->
  <div class="flex justify-center border-t-4 border-neon-pink bg-void px-2 py-3">
    <a href="/" class="pixel-title text-center text-lg sm:text-2xl">
      THE MANE ALLURE
    </a>
  </div>

  <!-- Menu -->
  <nav aria-label="Main">
    <ul
      class="flex flex-row flex-wrap items-center justify-center gap-x-4 gap-y-1 bg-void px-2 pb-2"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-pixel text-[9px] text-lavender hover:text-neon-yellow focus-visible:text-neon-yellow sm:text-[10px]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
