---
/**
 * Decorative 8-bit cloud layer.
 *
 * Drawn as SVG rects on an integer grid with shape-rendering="crispEdges", so
 * the blocks stay hard-edged at any scale -- a scaled-up bitmap would blur.
 * The gradient reuses the site's existing lavender -> periwinkle -> pink.
 *
 * Purely decorative: aria-hidden, pointer-events none, and it sits behind all
 * content.
 */

// Each cloud: position, width, opacity, and drift duration/delay.
const clouds = [
  { top: "6%", left: "-4%", width: "220px", opacity: 0.55, duration: "48s", delay: "0s" },
  { top: "18%", left: "72%", width: "300px", opacity: 0.4, duration: "62s", delay: "-8s" },
  { top: "34%", left: "8%", width: "180px", opacity: 0.35, duration: "55s", delay: "-20s" },
  { top: "48%", left: "78%", width: "240px", opacity: 0.45, duration: "70s", delay: "-30s" },
  { top: "63%", left: "-2%", width: "260px", opacity: 0.3, duration: "58s", delay: "-12s" },
  { top: "78%", left: "62%", width: "200px", opacity: 0.42, duration: "66s", delay: "-24s" },
  { top: "90%", left: "20%", width: "160px", opacity: 0.3, duration: "52s", delay: "-40s" },
];
---

<div class="cloud-layer" aria-hidden="true">
  {
    clouds.map((cloud, index) => (
      <svg
        class="pixel-cloud"
        viewBox="0 0 16 7"
        shape-rendering="crispEdges"
        style={`top:${cloud.top};left:${cloud.left};width:${cloud.width};opacity:${cloud.opacity};animation-duration:${cloud.duration};animation-delay:${cloud.delay};`}
      >
        <defs>
          <linearGradient id={`cloud-grad-${index}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ff8fd8" />
            <stop offset="45%" stop-color="#b9a7ff" />
            <stop offset="100%" stop-color="#4b44d4" />
          </linearGradient>
        </defs>

        <g fill={`url(#cloud-grad-${index})`}>
          {/* top lobe */}
          <rect x="6" y="0" width="3" height="1" />
          {/* second row, with a smaller right-hand puff */}
          <rect x="4" y="1" width="6" height="1" />
          <rect x="11" y="1" width="2" height="1" />
          {/* body */}
          <rect x="3" y="2" width="11" height="1" />
          <rect x="1" y="3" width="14" height="1" />
          <rect x="1" y="4" width="14" height="1" />
          <rect x="2" y="5" width="12" height="1" />
          {/* underside shading, one shade darker */}
          <rect x="4" y="6" width="8" height="1" opacity="0.55" />
        </g>
      </svg>
    ))
  }
</div>
